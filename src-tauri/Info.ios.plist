	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nekodesk.desktop</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nekodesk</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
